{
  "buildCommand": "node scripts/gerar-versao.js",
  "outputDirectory": "public",
  "cleanUrls": true,
  "redirects": [
    { "source": "/apresentacao", "destination": "/materiais/diagnostico-plano-midia-paga", "permanent": false }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "X-Robots-Tag", "value": "noindex, nofollow" } ] }
  ]
}
